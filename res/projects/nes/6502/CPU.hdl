And<1>(a=m24, b=t5, out=dec_84)
dec_85 = t4
dec_86 = t3
And<1>(a=m87, b=t0, out=dec_87)
And<1>(a=m30, b=t0, out=dec_88)
And<1>(a=m8, b=t5, out=dec_89)
And<1>(a=m83, b=t3, out=dec_90)
And<1>(a=m1, b=t4, out=dec_91)
