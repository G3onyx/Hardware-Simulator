And<1>(a=m120, b=t0, out=dec_120)
dec_121 = m121
And<1>(a=m31, b=t3, out=dec_122)
And<1>(a=m123, b=t2, out=dec_123)
And<1>(a=m82, b=t5, out=dec_124)
And<1>(a=m42, b=t4, out=dec_125)
dec_126 = m126
dec_127 = m127
dec_128 = m128
dec_129 = m129
dec_130 = 1'b0  // Line 130 tied to zero (unused)


// =====================================================================================================================
// RANDOM LOGIC & CONTROL COMMANDS
// =====================================================================================================================
// --- Shared Intermediate Signals ---
stor = dec_97
jsr2 = dec_48
jsr_5 = dec_56
rts_5 = dec_84
br2 = dec_80
br3 = dec_93

Neq<7>(a={dec_40, dec_26, dec_25, dec_24, dec_23, dec_22, dec_21}, b=7'b0, out=stkop)
Neq<6>(a={dec_104, dec_103, dec_102, dec_101, dec_100, dec_96}, b=6'b0, out=decoder_endx)

// --- Register Control Commands ---
// Y => SB
Neq<3>(a={dec_2, dec_1, dec_0}, b=3'b0, out=y_sb_1)
Neq<3>(a={dec_20, dec_19, dec_18}, b=3'b0, out=y_sb_2)
Neq<3>(a={dec_5, dec_4, dec_3}, b=3'b0, out=y_sb_3)
And<1>(a=stor, b=y_sb_1, out=y_sb_stor)
Neq<3>(a={y_sb_stor, y_sb_2, y_sb_3}, b=3'b0, out=next_cmd_y_sb)
Register<1>(in=next_cmd_y_sb, load=phi2, out=cmd_y_sb)

// X => SB
Neq<3>(a={dec_9, dec_8, dec_7}, b=3'b0, out=x_sb_1)
Neq<5>(a={dec_14, dec_13, dec_12, dec_11, dec_10}, b=5'b0, out=x_sb_2)
And<1>(a=stor, b=x_sb_1, out=x_sb_stor)
Or<1>(a=x_sb_stor, b=x_sb_2, out=next_cmd_x_sb)
Register<1>(in=next_cmd_x_sb, load=phi2, out=cmd_x_sb)

// SB => Y and SB => X
Neq<2>(a={dec_20, dec_19}, b=2'b0, out=next_cmd_sb_y)
Register<1>(in=next_cmd_sb_y, load=phi2, out=cmd_sb_y)

Neq<4>(a={dec_17, dec_16, dec_15, dec_14}, b=4'b0, out=next_cmd_sb_x)
Register<1>(in=next_cmd_sb_x, load=phi2, out=cmd_sb_x)

// Stack pointer controls (S => SB, S => ADL, SB => S)
Neq<3>(a={dec_14, dec_13, dec_12}, b=3'b0, out=next_cmd_s_sb)
Register<1>(in=next_cmd_s_sb, load=phi2, out=cmd_s_sb)

stk2 = dec_35
Or<1>(a=stkop, b=stk2, out=next_cmd_s_adl)
Register<1>(in=next_cmd_s_adl, load=phi2, out=cmd_s_adl)

next_cmd_sb_s = dec_13
Register<1>(in=next_cmd_sb_s, load=phi2, out=cmd_sb_s)

// --- PC Control Commands ---
Or<1>(a=brk5, b=brk6e, out=brk56)
Not<1>(in=brk56, out=n_brk56)

And<1>(a=m104, b=t0, out=jmp_t0)
Or<1>(a=dec_104, b=brk6e, out=load_pcl_from_dl)
Or<1>(a=jmp_t0, b=brk7, out=load_pch_from_dl)

Register<1>(in=load_pcl_from_dl, load=phi2, out=cmd_load_pcl_from_dl)
Register<1>(in=load_pch_from_dl, load=phi2, out=cmd_load_pch_from_dl)

Neq<4>(a={load_pch_from_dl, rts_5, br2, br3}, b=4'b0, out=next_cmd_adh_pch)
Register<1>(in=next_cmd_adh_pch, load=phi2, out=cmd_adh_pch)
Not<1>(in=next_cmd_adh_pch, out=next_cmd_pch_adh_raw)
And<1>(a=next_cmd_pch_adh_raw, b=n_brk56, out=next_cmd_pch_adh) // Float ADH during vector pull
Register<1>(in=next_cmd_pch_adh, load=phi2, out=cmd_pch_adh)

Neq<3>(a={jsr_5, dec_78, dec_77}, b=3'b0, out=next_cmd_pch_db)
Register<1>(in=next_cmd_pch_db, load=phi2, out=cmd_pch_db)
Register<1>(in=next_cmd_pch_db, load=phi2, out=cmd_pcl_db)

Neq<5>(a={load_pcl_from_dl, jsr_5, rts_5, br2, br3}, b=5'b0, out=next_cmd_adl_pcl)
Register<1>(in=next_cmd_adl_pcl, load=phi2, out=cmd_adl_pcl)
Not<1>(in=next_cmd_adl_pcl, out=next_cmd_pcl_adl_raw)
And<1>(a=next_cmd_pcl_adl_raw, b=n_brk56, out=next_cmd_pcl_adl) // Float ADL during vector pull
Register<1>(in=next_cmd_pcl_adl, load=phi2, out=cmd_pcl_adl)

Or<1>(a=t0, b=t1, out=next_cmd_inc_pc)
Register<1>(in=next_cmd_inc_pc, load=phi2, out=cmd_inc_pc)

// --- Bus Routing Commands ---
Neq<8>(a={fetch, t0, t1, t2, t3, t4, t5, brk6e}, b=8'b0, out=next_cmd_adh_abh)
Register<1>(in=next_cmd_adh_abh, load=phi2, out=cmd_adh_abh)
Register<1>(in=next_cmd_adh_abh, load=phi2, out=cmd_adl_abl)

Or<1>(a=dec_81, b=brk5, out=next_cmd_dl_adl)
Register<1>(in=next_cmd_dl_adl, load=phi2, out=cmd_dl_adl)
Or<1>(a=next_cmd_pch_db, b=brk6e, out=next_cmd_dl_adh)
Register<1>(in=next_cmd_dl_adh, load=phi2, out=cmd_dl_adh)

db_driven_by_pc = next_cmd_pch_db
Or<1>(a=next_cmd_ac_db, b=dec_99, out=db_driven_by_ac_p) // dec_99 is PHP
Or<1>(a=db_driven_by_pc, b=db_driven_by_ac_p, out=db_driven)
Not<1>(in=db_driven, out=next_cmd_dl_db)
Register<1>(in=next_cmd_dl_db, load=phi2, out=cmd_dl_db)

Register<1>(in=stor, load=phi2, out=cmd_wr)

// P => DB Latch (Status Register onto data bus)
Register<1>(in=dec_99, load=phi2, out=cmd_p_db) // Placeholder trigger for P->DB (e.g. PHP=dec_99)

// --- ALU & AC Routing Commands ---
Neq<8>(a={dec_65, dec_64, dec_63, dec_62, dec_61, dec_60, dec_59, dec_58}, b=8'b0, out=next_cmd_sb_ac)
Register<1>(in=next_cmd_sb_ac, load=phi2, out=cmd_sb_ac)

Neq<3>(a={dec_68, dec_67, dec_66}, b=3'b0, out=next_cmd_ac_sb)
Register<1>(in=next_cmd_ac_sb, load=phi2, out=cmd_ac_sb)

And<1>(a=dec_79, b=stor, out=next_cmd_ac_db)
Register<1>(in=next_cmd_ac_db, load=phi2, out=cmd_ac_db)

Neq<2>(a={dec_14, dec_13}, b=2'b0, out=next_cmd_add_sb)
Register<1>(in=next_cmd_add_sb, load=phi2, out=cmd_add_sb)

Neq<2>(a={dec_82, dec_81}, b=2'b0, out=next_cmd_add_adl)
Register<1>(in=next_cmd_add_adl, load=phi2, out=cmd_add_adl)

Neq<3>(a={dec_51, dec_50, dec_49}, b=3'b0, out=next_cmd_ndb_add)
Register<1>(in=next_cmd_ndb_add, load=phi2, out=cmd_ndb_add)

Neq<3>(a={dec_54, dec_53, dec_52}, b=3'b0, out=next_cmd_db_add)
Register<1>(in=next_cmd_db_add, load=phi2, out=cmd_db_add)

Neq<3>(a={dec_66, dec_65, dec_64}, b=3'b0, out=next_cmd_0_add)
Register<1>(in=next_cmd_0_add, load=phi2, out=cmd_0_add)

Neq<3>(a={dec_72, dec_71, dec_70}, b=3'b0, out=next_cmd_sb_add)
Register<1>(in=next_cmd_sb_add, load=phi2, out=cmd_sb_add)

Neq<2>(a={dec_74, dec_73}, b=2'b0, out=next_cmd_adl_add)
Register<1>(in=next_cmd_adl_add, load=phi2, out=cmd_adl_add)

Register<1>(in=next_cmd_db_add, load=phi2, out=cmd_sums)
Neq<2>(a={dec_70, dec_69}, b=2'b0, out=next_cmd_ands)
Register<1>(in=next_cmd_ands, load=phi2, out=cmd_ands)
Register<1>(in=dec_29, load=phi2, out=cmd_eors)
Register<1>(in=dec_32, load=phi2, out=cmd_ors)
Neq<2>(a={dec_76, dec_75}, b=2'b0, out=next_cmd_srs)
Register<1>(in=next_cmd_srs, load=phi2, out=cmd_srs)


// =====================================================================================================================
// REGISTERS (X, Y, S, PCL, PCH)
// =====================================================================================================================
Add<16>(a={pch_reg, pcl_reg}, b=16'd1, out=pc_inc)

Mux<8>(a=adl_bus, b=dl_reg, sel=cmd_load_pcl_from_dl, out=pcl_bus_or_dl)
Mux<8>(a=pcl_reg, b=pc_inc[0:7], sel=cmd_inc_pc, out=pcl_next_inc)
Mux<8>(a=pcl_next_inc, b=pcl_bus_or_dl, sel=cmd_adl_pcl, out=pcl_next)

Mux<8>(a=adh_bus, b=dl_reg, sel=cmd_load_pch_from_dl, out=pch_bus_or_dl)
Mux<8>(a=pch_reg, b=pc_inc[8:15], sel=cmd_inc_pc, out=pch_next_inc)
Mux<8>(a=pch_next_inc, b=pch_bus_or_dl, sel=cmd_adh_pch, out=pch_next)

Or<1>(a=cmd_inc_pc, b=cmd_adl_pcl, out=load_pcl)
And<1>(a=load_pcl, b=phi1, out=load_pcl_phi1)
Register<8>(in=pcl_next, load=load_pcl_phi1, out=pcl_reg) @PCL

Or<1>(a=cmd_inc_pc, b=cmd_adh_pch, out=load_pch)
And<1>(a=load_pch, b=phi1, out=load_pch_phi1)
Register<8>(in=pch_next, load=load_pch_phi1, out=pch_reg) @PCH

And<1>(a=cmd_sb_x, b=phi1, out=load_x)
Register<8>(in=sb_bus, load=load_x, out=x_reg) @X

And<1>(a=cmd_sb_y, b=phi1, out=load_y)
Register<8>(in=sb_bus, load=load_y, out=y_reg) @Y

And<1>(a=cmd_sb_s, b=phi1, out=load_s)
Register<8>(in=sb_bus, load=load_s, out=s_reg) @S


// =====================================================================================================================
// ARITHMETIC LOGIC UNIT (ALU)
// =====================================================================================================================
Mux<8>(a=sb_bus, b=8'd0, sel=cmd_0_add, out=ai_next)
Neq<2>(a={cmd_sb_add, cmd_0_add}, b=2'd0, out=ai_load)
Register<8>(in=ai_next, load=ai_load, out=ai_reg)

Not<8>(in=db_bus, out=ndb_bus)
Mux<8>(a=db_bus, b=ndb_bus, sel=cmd_ndb_add, out=bi_mux_db)
Mux<8>(a=bi_mux_db, b=adl_bus, sel=cmd_adl_add, out=bi_next)
Neq<3>(a={cmd_db_add, cmd_adl_add, cmd_ndb_add}, b=3'd0, out=bi_load)
Register<8>(in=bi_next, load=bi_load, out=bi_reg)

Register<8>(in=sb_bus, load=cmd_sb_ac, out=ac_reg)

Add<9>(a={1'b0, ai_reg}, b={1'b0, bi_reg}, out=sum_ab)
Add<9>(a=sum_ab, b={8'd0, c_flag}, out=sum_full)
sum_res = sum_full[0:7]
c_out = sum_full[8]

And<8>(a=ai_reg, b=bi_reg, out=and_res)
Or<8>(a=ai_reg, b=bi_reg, out=or_res)
Xor<8>(a=ai_reg, b=bi_reg, out=xor_res)
sr_res = {c_flag, ai_reg[1:7]}

Mux<8>(a=8'd0, b=sum_res, sel=cmd_sums, out=res_1)
Mux<8>(a=res_1, b=and_res, sel=cmd_ands, out=res_2)
Mux<8>(a=res_2, b=xor_res, sel=cmd_eors, out=res_3)
Mux<8>(a=res_3, b=or_res, sel=cmd_ors, out=res_4)
Mux<8>(a=res_4, b=sr_res, sel=cmd_srs, out=add_next)

Neq<5>(a={cmd_sums, cmd_ands, cmd_eors, cmd_ors, cmd_srs}, b=5'd0, out=add_load)
Register<8>(in=add_next, load=add_load, out=add_reg)

Xor<1>(a=ai_reg[7], b=bi_reg[7], out=xor_ab7)
Not<1>(in=xor_ab7, out=nxor_ab7)
Xor<1>(a=ai_reg[7], b=sum_res[7], out=xor_as7)
And<1>(a=nxor_ab7, b=xor_as7, out=avr_calc)
Mux<1>(a=1'b0, b=avr_calc, sel=cmd_sums, out=avr)

Mux<1>(a=1'b0, b=ai_reg[0], sel=cmd_srs, out=acr_srs)
Mux<1>(a=acr_srs, b=c_out, sel=cmd_sums, out=acr)


// =====================================================================================================================
// FLAGS AND STATUS REGISTER (P)
// =====================================================================================================================
Neq<8>(a=db_bus, b=8'd0, out=db_not_zero)
Not<1>(in=db_not_zero, out=db_is_zero)

Or<1>(a=dec_114, b=dec_115, out=plp_rti)
sec_clc = dec_110
sed_cld = dec_109
sei_cli = dec_108
clv     = dec_127

Mux<1>(a=acr, b=ireg[5], sel=sec_clc, out=c_mux_1)
Mux<1>(a=c_mux_1, b=db_bus[0], sel=plp_rti, out=c_next)
Neq<3>(a={cmd_sums, sec_clc, plp_rti}, b=3'd0, out=c_load)
And<1>(a=c_load, b=phi2, out=c_load_phi2)
Register<1>(in=c_next, load=c_load_phi2, out=c_flag)

Mux<1>(a=db_is_zero, b=db_bus[1], sel=plp_rti, out=z_next)
Neq<5>(a={add_load, cmd_sb_ac, cmd_sb_x, cmd_sb_y, plp_rti}, b=5'd0, out=z_load)
n_load = z_load
And<1>(a=z_load, b=phi2, out=z_load_phi2)
Register<1>(in=z_next, load=z_load_phi2, out=z_flag)

Mux<1>(a=ireg[5], b=db_bus[2], sel=plp_rti, out=i_next)
Or<1>(a=sei_cli, b=plp_rti, out=i_load)
And<1>(a=i_load, b=phi2, out=i_load_phi2)
Register<1>(in=i_next, load=i_load_phi2, out=i_flag)

Mux<1>(a=ireg[5], b=db_bus[3], sel=plp_rti, out=d_next)
Or<1>(a=sed_cld, b=plp_rti, out=d_load)
And<1>(a=d_load, b=phi2, out=d_load_phi2)
Register<1>(in=d_next, load=d_load_phi2, out=d_flag)

Mux<1>(a=avr, b=1'b0, sel=clv, out=v_mux_1)
Mux<1>(a=v_mux_1, b=db_bus[6], sel=plp_rti, out=v_next)
Neq<3>(a={cmd_sums, clv, plp_rti}, b=3'd0, out=v_load)
And<1>(a=v_load, b=phi2, out=v_load_phi2)
Register<1>(in=v_next, load=v_load_phi2, out=v_flag)

Mux<1>(a=db_bus[7], b=db_bus[7], sel=plp_rti, out=n_next)
And<1>(a=n_load, b=phi2, out=n_load_phi2)
Register<1>(in=n_next, load=n_load_phi2, out=n_flag)

p_out = {n_flag, v_flag, 1'b1, n_b_out, d_flag, i_flag, z_flag, c_flag}


// =====================================================================================================================
// EXTERNAL PINS & INTERNAL BUSES
// =====================================================================================================================
Not<1>(in=cmd_wr, out=cmd_rd)
rw = cmd_rd

Not<1>(in=force_adl0, out=keep_adl0)
Not<1>(in=force_adl1, out=keep_adl1)
Not<1>(in=force_adl2, out=keep_adl2)
And<8>(a=adl_bus, b={5'b11111, keep_adl2, keep_adl1, keep_adl0}, out=adl_masked)

And<1>(a=cmd_adl_abl, b=phi1, out=load_abl)
Register<8>(in=adl_masked, load=load_abl, out=abl_reg) @ABL

And<1>(a=cmd_adh_abh, b=phi1, out=load_abh)
Register<8>(in=adh_bus, load=load_abh, out=abh_reg) @ABH
addr = {abh_reg, abl_reg}

Register<8>(in=data_in, load=phi2, out=dl_reg) @DL

And<1>(a=cmd_dl_db, b=cmd_wr, out=write_mode_dl)
And<1>(a=write_mode_dl, b=phi1, out=load_dor)
Register<8>(in=db_bus, load=load_dor, out=data_out) @DOR

// SB Bus 
Mux<8>(a=BUS_DEFAULT, b=y_reg, sel=cmd_y_sb, out=sb_driven_by_y)
Mux<8>(a=sb_driven_by_y, b=x_reg, sel=cmd_x_sb, out=sb_driven_by_x)
Mux<8>(a=sb_driven_by_x, b=s_reg, sel=cmd_s_sb, out=sb_driven_by_s)
Mux<8>(a=sb_driven_by_s, b=ac_reg, sel=cmd_ac_sb, out=sb_driven_by_ac)
Mux<8>(a=sb_driven_by_ac, b=add_reg, sel=cmd_add_sb, out=sb_bus)

// ADH Bus
Mux<8>(a=BUS_DEFAULT, b=pch_reg, sel=cmd_pch_adh, out=adh_driven_by_pch)
Mux<8>(a=adh_driven_by_pch, b=dl_reg, sel=cmd_dl_adh, out=adh_bus)

// ADL Bus
Mux<8>(a=BUS_DEFAULT, b=s_reg, sel=cmd_s_adl, out=adl_driven_by_s)
Mux<8>(a=adl_driven_by_s, b=pcl_reg, sel=cmd_pcl_adl, out=adl_driven_by_pcl)
Mux<8>(a=adl_driven_by_pcl, b=dl_reg, sel=cmd_dl_adl, out=adl_driven_by_dl)
Mux<8>(a=adl_driven_by_dl, b=add_reg, sel=cmd_add_adl, out=adl_bus)

// DB Bus 
Mux<8>(a=BUS_DEFAULT, b=pcl_reg, sel=cmd_pcl_db, out=db_driven_by_pcl)
Mux<8>(a=db_driven_by_pcl, b=pch_reg, sel=cmd_pch_db, out=db_driven_by_pch)
Mux<8>(a=db_driven_by_pch, b=ac_reg, sel=cmd_ac_db, out=db_driven_by_ac)
Mux<8>(a=db_driven_by_ac, b=p_out, sel=cmd_p_db, out=db_driven_by_p)

And<1>(a=cmd_dl_db, b=cmd_rd, out=read_mode_dl)
Mux<8>(a=db_driven_by_p, b=dl_reg, sel=read_mode_dl, out=db_bus)


// =====================================================================================================================
// UNUSED WIRE SINKS
// =====================================================================================================================
_ = so
_ = jsr2
_ = dec_6
_ = dec_27
_ = dec_28
_ = dec_30
_ = dec_31
_ = dec_33
_ = dec_34
_ = dec_36
_ = dec_37
_ = dec_38
_ = dec_39
_ = dec_41
_ = dec_42
_ = dec_43
_ = dec_44
_ = dec_45
_ = dec_46
_ = dec_47
_ = dec_55
_ = dec_57
_ = dec_83
_ = dec_85
_ = dec_86
_ = dec_87
_ = dec_88
_ = dec_89
_ = dec_90
_ = dec_91
_ = dec_92
_ = dec_94
_ = dec_95
_ = dec_98
_ = dec_105
_ = dec_106
_ = dec_107
_ = dec_111
_ = dec_112
_ = dec_113
_ = dec_116
_ = dec_117
_ = dec_118
_ = dec_119
_ = dec_120
_ = dec_121
_ = dec_122
_ = dec_123
_ = dec_124
_ = dec_125
_ = dec_126
_ = dec_128
_ = dec_129
_ = dec_130