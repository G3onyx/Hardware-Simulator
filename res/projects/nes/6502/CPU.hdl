And<1>(a=m104, b=t2, out=dec_104)
And<1>(a=m25, b=t3, out=dec_105)
dec_106 = m106
dec_107 = m55
And<1>(a=m108, b=t0, out=dec_108)
And<1>(a=m69, b=t1, out=dec_109)
And<1>(a=m110, b=t0, out=dec_110)
And<1>(a=m111, b=t3, out=dec_111)
And<1>(a=m52, b=t1, out=dec_112)
And<1>(a=m69, b=t0, out=dec_113)
And<1>(a=m114, b=t0, out=dec_114)
And<1>(a=m26, b=t4, out=dec_115)
And<1>(a=m50, b=t1, out=dec_116)
