CHIP CPU  // MOS 6502 Core

@const(cpu_constants)
@const(decoder_masks)

IN
data_in[8]
n_nmi  // Non-maskable interrupt signal (active low)
n_irq  // Maskable interrupt signal (active low)
n_res  // Reset signal (active low)
phi0  // Reference clock signal
rdy   // Processor ready (1 = ready)
so    // Forced setting of the overflow flag (V)

OUT
addr[16]
data_out[8]
phi1  // First half-cycle, processor in writing mode (= ¬phi0)
phi2  // Second half-cycle, processor in read mode   (=  phi0)
rw    // Data bus direction (1 = reading, 0 = writing)
sync  // The processor is on cycle T1 (opcode fetch)

PARTS

// =====================================================================================================================
// CLOCK GENERATOR
// =====================================================================================================================
Not<1>(in=phi0, out=phi1)
phi2 = phi0


// =====================================================================================================================
// PREDECODE LOGIC: Determines instruction class from PD latch
// =====================================================================================================================

// Predecode (PD) latch grabs data on PHI2
Register<8>(in=data_in, load=phi2, out=pd)

// 2-cycle instructions
Eq<4>(a={pd[4], pd[3], pd[2], pd[0]}, b=MASK_2C_A, out=is_2c_a)
Eq<5>(a={pd[7], pd[4], pd[3], pd[2], pd[0]}, b=MASK_2C_B, out=is_2c_b)
// Single-byte instructions
Eq<3>(a={pd[3], pd[2], pd[0]}, b=MASK_IMPLIED, out=implied)
// Push/Pull
Eq<3>(a={pd[7], pd[4], pd[1]}, b=MASK_PUSHPULL, out=is_pushpull)
Not<1>(in=is_pushpull, out=n_is_pushpull)

// TWOCYCLE flag
And<1>(a=implied, b=n_is_pushpull, out=implied_valid)
Or<1>(a=is_2c_a, b=is_2c_b, out=is_2c)
Or<1>(a=is_2c, b=implied_valid, out=twocycle)
Not<1>(in=twocycle, out=n_twocycle)


// =====================================================================================================================
// INTERRUPT AND BRK SEQUENCE LOGIC
// =====================================================================================================================
Not<1>(in=n_irq, out=irq)
Not<1>(in=n_nmi, out=nmi)
Not<1>(in=n_res, out=res)

// NMI edge detect: Detects falling edge of n_nmi and latches it until interrupt sequence begins
Dff<1>(in=nmi, out=nmi_sync)
Not<1>(in=nmi_sync, out=n_nmi_sync)
And<1>(a=nmi, b=n_nmi_sync, out=nmi_edge)

Or<1>(a=nmi_edge, b=nmi_pending, out=nmi_set)
Not<1>(in=b_out, out=n_b_out) // Clear pending NMI when B_OUT (interrupt start) fires
And<1>(a=nmi_set, b=n_b_out, out=next_nmi_pending)
Dff<1>(in=next_nmi_pending, out=nmi_pending)

// IRQ and reset check
Not<1>(in=i_flag, out=n_i_flag)
And<1>(a=irq, b=n_i_flag, out=irq_pending)

// DORES: Synchronized reset flag
Register<1>(in=res, load=rdy, out=dores)

// Interrupt arrived, so force execution of BRK by injecting 0x00 into the IR
Or<1>(a=nmi_pending, b=irq_pending, out=any_int)
Or<1>(a=any_int, b=dores, out=any_int_or_res)
Register<1>(in=any_int_or_res, load=fetch, out=b_out) // Poll for interrupts at the end of the current instruction (during fetch)

// Interrupt vector address setting
// Forces lower bits of the ADL bus to 0 to jump to the correct vector
// FFFA (NMI), FFFC (RESET), FFFE (IRQ/BRK)
force_adl0 = brk5         // Active during T5 (low byte of vector)
force_adl1 = dores        // Active for RESET (FFFC)
force_adl2 = nmi_pending  // Active for NMI (FFFA)


// =====================================================================================================================
// DISPATCHER AND CYCLE COUNTERS
// =====================================================================================================================
Not<1>(in=rdy, out=n_rdy)

// Deadlock Recovery: If all T-states are 0, force a fetch to jumpstart the CPU into T0
Neq<8>(a={t0, t1, t2, t3, t4, t5, brk6e, brk7}, b=8'b0, out=any_t_active)
Not<1>(in=any_t_active, out=dead_state)

// An instruction is complete if it's a TWOCYCLE instruction currently in T1
And<1>(a=twocycle, b=t1, out=ends)  // Reset short instruction cycle counter
Or<1>(a=decoder_endx, b=brk7, out=endx)
Or<1>(a=ends, b=endx, out=fetch_normal)
Or<1>(a=fetch_normal, b=dead_state, out=fetch) // Inject recovery

// Shift register for T0-T1
Mux<2>(a=state_t, b={t0, 1'b0}, sel=rdy, out=held_or_shifted_t)  // If ready, shift
Mux<2>(a=held_or_shifted_t, b=STATE_T0, sel=fetch, out=next_t)  // If fetch, force state back to T0
Dff<2>(in=next_t, out=state_t)
t0 = state_t[0]
t1 = state_t[1]

sync = t1

// Extended counter T2-T5: Triggers if T1 completes and it's not a 2-cycle instruction
And<1>(a=t1, b=n_twocycle, out=start_t2)
shifted_t25 = {state_t25[2], state_t25[1], state_t25[0], start_t2}
Mux<4>(a=shifted_t25, b=state_t25, sel=n_rdy, out=held_t25)
Mux<4>(a=held_t25, b=4'b0000, sel=fetch, out=next_t25)
Dff<4>(in=next_t25, out=state_t25)
t2 = state_t25[0]
t3 = state_t25[1]
t4 = state_t25[2]
t5 = state_t25[3]

// Interrupt sequence counter T6-T7 (BRK6E, BRK7)
// BRK takes 7 cycles. Trigger cycle 6 from T5 if an interrupt is active (b_out)
And<1>(a=b_out, b=t5, out=brk5)
Register<1>(in=brk5, load=rdy, out=brk6e)
Register<1>(in=brk6e, load=rdy, out=brk7)


// =====================================================================================================================
// INSTRUCTION REGISTER (IR)
// =====================================================================================================================
// Inject BRK (0x00) opcode for interrupt handling
Mux<8>(a=pd, b=BRK_OPCODE, sel=b_out, out=opcode)

And<1>(a=fetch, b=phi1, out=ireg_load)
Register<8>(in=opcode, load=ireg_load, out=ireg) @I


// =====================================================================================================================
// DECODER
// =====================================================================================================================
// UNIQUE MASK MATCHES
// Extracting only the relevant bits defined by the 'X' Don't Care boundaries
Eq<6>(a={ireg[7], ireg[6], ireg[5], ireg[2], ireg[1], ireg[0]}, b=MASK_M0, out=m0)
Eq<4>(a={ireg[4], ireg[3], ireg[2], ireg[0]}, b=MASK_M1, out=m1)
Eq<4>(a={ireg[4], ireg[3], ireg[2], ireg[0]}, b=MASK_M2, out=m2)
Eq<7>(a={ireg[7], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M3, out=m3)
Eq<8>(a=ireg, b=MASK_M4, out=m4)
Eq<6>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[1], ireg[0]}, b=MASK_M5, out=m5)
Eq<2>(a={ireg[4], ireg[2]}, b=MASK_M6, out=m6)
Eq<3>(a={ireg[7], ireg[6], ireg[1]}, b=MASK_M7, out=m7)
Eq<4>(a={ireg[4], ireg[3], ireg[2], ireg[0]}, b=MASK_M8, out=m8)
Eq<7>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M9, out=m9)
Eq<7>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M10, out=m10)
Eq<6>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[1], ireg[0]}, b=MASK_M11, out=m11)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[1]}, b=MASK_M12, out=m12)
Eq<7>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M13, out=m13)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[1]}, b=MASK_M14, out=m14)
Eq<8>(a=ireg, b=MASK_M16, out=m16)
Eq<7>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M17, out=m17)
Eq<6>(a={ireg[7], ireg[6], ireg[5], ireg[2], ireg[1], ireg[0]}, b=MASK_M19, out=m19)
Eq<6>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[1], ireg[0]}, b=MASK_M20, out=m20)
Eq<8>(a=ireg, b=MASK_M21, out=m21)
Eq<8>(a=ireg, b=MASK_M22, out=m22)
Eq<7>(a={ireg[7], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M23, out=m23)
Eq<8>(a=ireg, b=MASK_M24, out=m24)
Eq<7>(a={ireg[7], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M25, out=m25)
Eq<8>(a=ireg, b=MASK_M26, out=m26)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[1]}, b=MASK_M27, out=m27)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M29, out=m29)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M30, out=m30)
Eq<3>(a={ireg[4], ireg[3], ireg[2]}, b=MASK_M31, out=m31)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M32, out=m32)
Eq<1>(a=ireg[3], b=MASK_M33, out=m33)
Eq<5>(a={ireg[7], ireg[4], ireg[2], ireg[1], ireg[0]}, b=MASK_M35, out=m35)
Eq<4>(a={ireg[7], ireg[4], ireg[1], ireg[0]}, b=MASK_M36, out=m36)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M37, out=m37)
Eq<2>(a={ireg[4], ireg[3]}, b=MASK_M42, out=m42)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[1]}, b=MASK_M44, out=m44)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M47, out=m47)
Eq<5>(a={ireg[7], ireg[6], ireg[4], ireg[1], ireg[0]}, b=MASK_M49, out=m49)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M50, out=m50)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M51, out=m51)
Eq<3>(a={ireg[6], ireg[5], ireg[0]}, b=MASK_M52, out=m52)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[1]}, b=MASK_M53, out=m53)
Eq<3>(a={ireg[7], ireg[6], ireg[1]}, b=MASK_M55, out=m55)
Eq<2>(a={ireg[7], ireg[0]}, b=MASK_M59, out=m59)
Eq<5>(a={ireg[7], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M61, out=m61)
Eq<8>(a=ireg, b=MASK_M63, out=m63)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M64, out=m64)
Eq<1>(a=ireg[0], b=MASK_M65, out=m65)
Eq<8>(a=ireg, b=MASK_M66, out=m66)
Eq<7>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M68, out=m68)
Eq<7>(a={ireg[7], ireg[6], ireg[5], ireg[4], ireg[2], ireg[1], ireg[0]}, b=MASK_M69, out=m69)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M70, out=m70)
Eq<5>(a={ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M73, out=m73)
Eq<8>(a=ireg, b=MASK_M74, out=m74)
Eq<6>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M75, out=m75)
Eq<3>(a={ireg[7], ireg[6], ireg[1]}, b=MASK_M76, out=m76)
Eq<4>(a={ireg[7], ireg[6], ireg[5], ireg[0]}, b=MASK_M79, out=m79)
Eq<2>(a={ireg[3], ireg[2]}, b=MASK_M81, out=m81)
Eq<3>(a={ireg[3], ireg[2], ireg[0]}, b=MASK_M82, out=m82)
Eq<1>(a=ireg[3], b=MASK_M83, out=m83)
Eq<7>(a={ireg[7], ireg[5], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M87, out=m87)
Eq<3>(a={ireg[7], ireg[6], ireg[5]}, b=MASK_M97, out=m97)
Eq<8>(a=ireg, b=MASK_M99, out=m99)
Eq<8>(a=ireg, b=MASK_M104, out=m104)
Eq<2>(a={ireg[6], ireg[1]}, b=MASK_M106, out=m106)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M108, out=m108)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M110, out=m110)
Eq<3>(a={ireg[4], ireg[3], ireg[2]}, b=MASK_M111, out=m111)
Eq<8>(a=ireg, b=MASK_M114, out=m114)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M117, out=m117)
Eq<6>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1]}, b=MASK_M118, out=m118)
Eq<6>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[1], ireg[0]}, b=MASK_M119, out=m119)
Eq<7>(a={ireg[7], ireg[6], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M120, out=m120)
Eq<1>(a=ireg[6], b=MASK_M121, out=m121)
Eq<3>(a={ireg[4], ireg[3], ireg[2]}, b=MASK_M123, out=m123)
Eq<1>(a=ireg[7], b=MASK_M126, out=m126)
Eq<8>(a=ireg, b=MASK_M127, out=m127)
Eq<3>(a={ireg[3], ireg[2], ireg[0]}, b=MASK_M128, out=m128)
Eq<6>(a={ireg[7], ireg[4], ireg[3], ireg[2], ireg[1], ireg[0]}, b=MASK_M129, out=m129)

// FULL DECODE STAGE (Lines 0 to 129)
dec_0 = m0
And<1>(a=m1, b=t3, out=dec_1)
And<1>(a=m2, b=t2, out=dec_2)
And<1>(a=m3, b=t0, out=dec_3)
And<1>(a=m4, b=t0, out=dec_4)
And<1>(a=m5, b=t0, out=dec_5)
And<1>(a=m6, b=t2, out=dec_6)
dec_7 = m7
And<1>(a=m8, b=t2, out=dec_8)
And<1>(a=m9, b=t0, out=dec_9)
And<1>(a=m10, b=t0, out=dec_10)
And<1>(a=m11, b=t0, out=dec_11)
dec_12 = m12
And<1>(a=m13, b=t0, out=dec_13)
And<1>(a=m14, b=t0, out=dec_14)
And<1>(a=m10, b=t1, out=dec_15)
And<1>(a=m16, b=t1, out=dec_16)
And<1>(a=m17, b=t0, out=dec_17)
And<1>(a=m3, b=t1, out=dec_18)
And<1>(a=m19, b=t0, out=dec_19)
And<1>(a=m20, b=t0, out=dec_20)
And<1>(a=m21, b=t0, out=dec_21)
And<1>(a=m22, b=t5, out=dec_22)
And<1>(a=m23, b=t0, out=dec_23)
And<1>(a=m24, b=t4, out=dec_24)
And<1>(a=m25, b=t3, out=dec_25)
And<1>(a=m26, b=t5, out=dec_26)
dec_27 = m27
dec_28 = t2
And<1>(a=m29, b=t0, out=dec_29)
dec_30 = m30
And<1>(a=m31, b=t2, out=dec_31)
And<1>(a=m32, b=t0, out=dec_32)
And<1>(a=m33, b=t2, out=dec_33)
dec_34 = t0
And<1>(a=m35, b=t2, out=dec_35)
And<1>(a=m36, b=t3, out=dec_36)
And<1>(a=m37, b=t4, out=dec_37)
And<1>(a=m26, b=t4, out=dec_38)
And<1>(a=m8, b=t3, out=dec_39)
And<1>(a=m1, b=t4, out=dec_40)
And<1>(a=m1, b=t2, out=dec_41)
And<1>(a=m42, b=t3, out=dec_42)
dec_43 = m25
dec_44 = m44
And<1>(a=m8, b=t4, out=dec_45)
And<1>(a=m1, b=t3, out=dec_46)
dec_47 = m47
And<1>(a=m21, b=t2, out=dec_48)
And<1>(a=m49, b=t0, out=dec_49)
And<1>(a=m50, b=t0, out=dec_50)
And<1>(a=m51, b=t0, out=dec_51)
And<1>(a=m52, b=t0, out=dec_52)
dec_53 = m53
And<1>(a=m30, b=t3, out=dec_54)
dec_55 = m55
And<1>(a=m21, b=t5, out=dec_56)
And<1>(a=m35, b=t2, out=dec_57)
And<1>(a=m4, b=t0, out=dec_58)
And<1>(a=m59, b=t1, out=dec_59)
And<1>(a=m52, b=t1, out=dec_60)
And<1>(a=m61, b=t1, out=dec_61)
And<1>(a=m9, b=t0, out=dec_62)
And<1>(a=m63, b=t0, out=dec_63)
And<1>(a=m64, b=t0, out=dec_64)
And<1>(a=m65, b=t0, out=dec_65)
And<1>(a=m66, b=t0, out=dec_66)
And<1>(a=m61, b=t0, out=dec_67)
And<1>(a=m68, b=t0, out=dec_68)
And<1>(a=m69, b=t0, out=dec_69)
And<1>(a=m70, b=t0, out=dec_70)
And<1>(a=m42, b=t4, out=dec_71)
And<1>(a=m1, b=t5, out=dec_72)

// Decoder X73 is uniquely affected by /PRDY
And<1>(a=m73, b=t0, out=dec_73_raw)
And<1>(a=dec_73_raw, b=n_rdy, out=dec_73)

And<1>(a=m74, b=t2, out=dec_74)
And<1>(a=m75, b=t0, out=dec_75)
dec_76 = m76
And<1>(a=m22, b=t2, out=dec_77)
And<1>(a=m21, b=t3, out=dec_78)
dec_79 = m79
And<1>(a=m73, b=t2, out=dec_80)
