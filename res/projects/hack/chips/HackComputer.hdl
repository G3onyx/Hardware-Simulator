CHIP HackComputer

@toplevel

IN reset

PARTS

CPU(
    instruction=instruction
    inM=memoryOut
    reset=reset
    outM=outM
    writeM=writeM
    addressM=addressM
    pc=pc
)

// RAM + Screen + Keyboard
Memory(in=outM, address=addressM, load=writeM, out=memoryOut)

ROM<15, 16>(address=pc, out=instruction) @ROM32K