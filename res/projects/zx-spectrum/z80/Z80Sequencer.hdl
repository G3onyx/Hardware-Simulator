CHIP Z80Sequencer

@const(z80_opcodes)
@const(z80_regs)

IN
    reset_n, wait_n, int_n, din[8],
    regA[16], regB[16],
    aluOut[8], aluFlags[8]

OUT
    dout[8], addr[16],
    mreq_n, iorq_n, rd_n, wr_n, m1_n, rfsh_n,
    regSelA[4], regSelB[4], regWriteSel[4],
    regWe, altAF, altEXX, aluOp[4], regWriteData[16],
    aluSrc[8]

PARTS
    Z80Decoder(
        ir=ir, prefix=pr, isPrefix=isPrefix, isLoad8=isLoad8, isLoad8Imm=isLoad8Imm,
        isALU8=isALU8, isALUImm=isALUImm, isLoad16Imm=isLoad16Imm,
        isPushPop=isPushPop, isMemWrite=isMemWrite, isJump=isJump,
        aluOp=aluOp, reqM2_Read=reqM2_Read, reqM3_Read=reqM3_Read,
        reqM2_Write=reqM2_Write, isIORead=isIORead, isIOWrite=isIOWrite,
        isExx=isExx, isExAF=isExAF
    )

    Mux<8>(a=pr, b=ir, sel=isPrefix, out=nextPR)
    Dff<8>(in=nextPR, out=pr)

    // Hardware Reset & Cold-Boot Anti-Deadlock Logic
    Not<1>(in=reset_n, out=isReset)
    Eq<3>(a=tState, b=3'd0, out=isT0)
    Eq<3>(a=mCycle, b=3'd0, out=isM0)
    Or<1>(a=isReset, b=isT0, out=forceT1)
    Or<1>(a=isReset, b=isM0, out=forceM1)

    Eq<3>(a=tState, b=3'd1, out=isT1)
    Eq<3>(a=tState, b=3'd2, out=isT2)
    Eq<3>(a=tState, b=3'd3, out=isT3)
    Eq<3>(a=tState, b=3'd4, out=isT4)

    Eq<3>(a=mCycle, b=3'd1, out=isM1)
    Eq<3>(a=mCycle, b=3'd2, out=isM2)
    Eq<3>(a=mCycle, b=3'd3, out=isM3)

    And<1>(a=isM1, b=isT4, out=endM1)
    And<1>(a=isM2, b=isT4, out=endM2_cycle)
    And<1>(a=isM3, b=isT4, out=endM3_cycle)

    Or<1>(a=endM1, b=endM2_cycle, out=endM_12)
    Or<1>(a=endM_12, b=endM3_cycle, out=wrapT)

    Not<1>(in=reqM2_Read, out=noM2)
    Not<1>(in=reqM3_Read, out=noM3)
    And<1>(a=endM1, b=noM2, out=endSimple)
    And<1>(a=endM2_cycle, b=noM3, out=endAtM2)
    Or<1>(a=endSimple, b=endAtM2, out=endOrM2)
    Or<1>(a=endOrM2, b=endM3_cycle, out=endOrM3)
    Or<1>(a=endOrM3, b=isPrefix, out=endInstruction)

    // Advanced T-State Routing
    Not<1>(in=wait_n, out=isWait)
    Add<3>(a=tState, b=3'd1, out=tPlus1)
    Mux<3>(a=tPlus1, b=3'd1, sel=wrapT, out=tNextNorm)
    Mux<3>(a=tNextNorm, b=tState, sel=isWait, out=nextT_wait)
    Mux<3>(a=nextT_wait, b=3'd1, sel=forceT1, out=nextT)
    Dff<3>(in=nextT, out=tState)

    // Advanced M-Cycle Routing
    Add<3>(a=mCycle, b=3'd1, out=mPlus1)
    Mux<3>(a=mCycle, b=mPlus1, sel=wrapT, out=nextM_adv)
    Mux<3>(a=nextM_adv, b=3'd1, sel=endInstruction, out=nextM_instr)
    Mux<3>(a=nextM_instr, b=3'd1, sel=forceM1, out=nextM)
    Dff<3>(in=nextM, out=mCycle)

    Not<1>(in=int_n, out=intActive)
    And<1>(a=endInstruction, b=intActive, out=nextIntState)
    Dff<1>(in=nextIntState, out=intTriggered)
    And<1>(a=isM1, b=isT3, out=grabIR)
    Mux<8>(a=din, b=8'xFF, sel=intTriggered, out=fetchData)
    Mux<8>(a=ir, b=fetchData, sel=grabIR, out=nextIR)
    Dff<8>(in=nextIR, out=ir)

    Z80OctalMapper(octal=ir[3:5], prefix=pr, reg16=destReg, isHigh=destHigh, isMemory=destMem)
    Z80OctalMapper(octal=ir[0:2], prefix=pr, reg16=srcReg,  isHigh=srcHigh,  isMemory=srcMem)

    Or<1>(a=isT1, b=isT2, out=isT1orT2)
    Or<1>(a=isT1orT2, b=isT3, out=isT1toT3)
    And<1>(a=isM1, b=isT1orT2, out=m1_fetch)

    Or<1>(a=isM2, b=isM3, out=isMultiM)
    And<1>(a=isMultiM, b=isT1orT2, out=multi_active)
    Or<1>(a=isIORead, b=isIOWrite, out=doIO)
    And<1>(a=doIO, b=multi_active, out=io_active)
    Not<1>(in=doIO, out=notIO)
    And<1>(a=multi_active, b=notIO, out=mem_multi_active)
    Or<1>(a=m1_fetch, b=mem_multi_active, out=mem_active)

    And<1>(a=io_active, b=isIORead, out=seq_io_read)
    And<1>(a=io_active, b=isIOWrite, out=seq_io_write)
    Or<1>(a=mem_active, b=seq_io_read, out=final_rd)

    Not<1>(in=mem_active, out=mreq_n)
    Not<1>(in=io_active, out=iorq_n)
    Not<1>(in=final_rd, out=rd_n)
    Not<1>(in=seq_io_write, out=wr_n)
    Not<1>(in=m1_fetch, out=m1_n)

    And<1>(a=isM1, b=isT3, out=incM1)
    And<1>(a=isM2, b=isT3, out=incM2)
    And<1>(a=isM3, b=isT3, out=incM3)
    And<1>(a=incM2, b=reqM2_Read, out=incM2_Read)
    And<1>(a=incM3, b=reqM3_Read, out=incM3_Read)
    Or<1>(a=incM1, b=incM2_Read, out=incM12)
    Or<1>(a=incM12, b=incM3_Read, out=inc_pc)

    And<1>(a=endM1, b=isLoad8, out=exec_LD8)
    And<1>(a=endM1, b=isALU8, out=exec_ALU8)
    And<1>(a=endM3_cycle, b=isLoad16Imm, out=exec_LD16)

    And<1>(a=isM2, b=isT3, out=grabM2)
    Mux<16>(a=tempZ, b={8'd0, din}, sel=grabM2, out=nextTempZ)
    Dff<16>(in=nextTempZ, out=tempZ)

    Or<1>(a=exec_LD8, b=exec_ALU8, out=write_8bit)
    Or<1>(a=write_8bit, b=exec_LD16, out=write_target)

    // Core logic interception for resetting the Program Counter
    Or<1>(a=inc_pc, b=write_target, out=regWe_norm)
    Or<1>(a=regWe_norm, b=isReset, out=regWe)

    Mux<4>(a=REG16_PC, b=destReg, sel=write_target, out=regWriteSel_norm)
    Mux<4>(a=regWriteSel_norm, b=REG16_PC, sel=isReset, out=regWriteSel)

    Mux<8>(a=regB[0:7], b=regB[8:15], sel=srcHigh, out=src8)
    Mux<8>(a=regA[0:7], b=aluFlags, sel=exec_ALU8, out=nextF)
    Mux<8>(a=regA[0:7], b=regA[8:15], sel=destHigh, out=dest8_preserved)
    Mux<8>(a=src8, b=aluOut, sel=exec_ALU8, out=result8)

    Mux<16>(a={regA[8:15], result8}, b={result8, nextF}, sel=destHigh, out=dest16_packed)
    Mux<16>(a=dest16_packed, b={din, tempZ[0:7]}, sel=exec_LD16, out=final_write_data)
    Add<16>(a=regA, b=16'd1, out=pcPlus1)

    // Core logic interception for overriding PC data with zero
    Mux<16>(a=pcPlus1, b=final_write_data, sel=write_target, out=regWriteData_norm)
    Mux<16>(a=regWriteData_norm, b=16'd0, sel=isReset, out=regWriteData)

    Add<8>(a=regR, b=8'd1, out=nextR)
    Mux<8>(a=regR, b=nextR, sel=incM1, out=newR)
    Dff<8>(in=newR, out=regR)

    Or<1>(a=isT3, b=isT4, out=isT3orT4)
    And<1>(a=isM1, b=isT3orT4, out=doRefresh)
    Not<1>(in=doRefresh, out=rfsh_n)
    altAF = isExAF
    altEXX = isExx

    Mux<4>(a=destReg, b=REG16_PC, sel=isT1toT3, out=addrRegSel)
    Mux<4>(a=addrRegSel, b=REG16_IR, sel=doRefresh, out=regSelA)
    Mux<4>(a=REG16_PC, b=srcReg, sel=isT4, out=regSelB)

    Mux<16>(a=regA, b={regA[8:15], regR}, sel=doRefresh, out=addr)
    dout = regA[0:7]
    aluSrc = src8